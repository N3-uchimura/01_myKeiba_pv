{
  "name": "mykeiba",
  "productName": "mykeiba personal",
  "version": "1.0.0",
  "private": true,
  "description": "personal application for getting keiba data.",
  "main": "build/mykeiba.js",
  "scripts": {
    "build": "tsc && chcp 65001",
    "start": "npm run build && electron .",
    "build-win": "npm run build && electron-builder --win --x64"
  },
  "keywords": [],
  "author": {
    "name": "numthree-uchimura (https://github.com/N3-uchimura/)",
    "email": "uchimura@numthree.net"
  },
  "dependencies": {
    "@types/dotenv": "^6.1.1",
    "axios": "^1.9.0",
    "csv": "^6.3.11",
    "dayjs": "^1.11.13",
    "dotenv": "^16.5.0",
    "electron-log": "^5.3.0",
    "iconv-lite": "^0.6.3",
    "mime-types": "^3.0.1",
    "node-cache": "^5.1.2",
    "puppeteer-core": "^23.6.1"
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.15.30",
    "electron": "^39.5.1",
    "electron-builder": "^26.4.0",
    "typescript": "^4.6.4"
  },
  "build": {
    "appId": "net.numthree.mykeiba",
    "productName": "mykeiba",
    "files": [
      "build/**/*",
      "package.json",
      "!dist/**/*",
      "!src/**/*",
      "!.gitignore",
      "!.vscode"
    ],
    "extraResources": [
      "assets",
      "www/**/*"
    ],
    "squirrelWindows": {},
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/keiba128.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
