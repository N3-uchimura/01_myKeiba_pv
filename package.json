{
  "name": "mykeiba",
  "productName": "mykeiba personal",
  "version": "1.0.2",
  "private": true,
  "description": "personal application for getting keiba data.",
  "main": "build/mykeiba.js",
  "scripts": {
    "build": "tsc && chcp 65001",
    "start": "npm run build && electron .",
    "build-win": "npm run build && electron-builder --win --x64"
  },
  "keywords": [],
  "author": {
    "name": "numthree-uchimura (https://github.com/N3-uchimura/)",
    "email": "uchimura@numthree.net"
  },
  "overrides": {
    "http-cache-semantics": "^4.1.1"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "csv": "^6.3.11",
    "dotenv": "^18.0.5",
    "electron-log": "^5.4.2",
    "iconv-lite": "^0.6.3",
    "node-cache": "^5.1.2",
    "puppeteer-core": "^25.12.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "electron": "^44.5.1",
    "electron-builder": "^27.0.0-alpha.9",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "net.numthree.mykeiba",
    "productName": "mykeiba",
    "files": [
      "build/**/*",
      "package.json",
      "!dist/**/*",
      "!src/**/*",
      "!.gitignore",
      "!.vscode"
    ],
    "extraResources": [
      "assets",
      "www/**/*"
    ],
    "squirrelWindows": {},
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/keiba256.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
